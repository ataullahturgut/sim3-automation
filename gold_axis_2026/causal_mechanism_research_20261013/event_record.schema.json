        "first_observed_reaction_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "threshold_crossing_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrospective_peak_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp_confidence": {
          "enum": [
            "VERIFIED_ORIGINAL",
            "OFFICIAL_SCHEDULE_ONLY",
            "DATE_ONLY",
            "INTERVAL",
            "UNKNOWN"
          ]
        }
      },
      "additionalProperties": false
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "evidence_status",
          "source_ids"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "evidence_status": {
            "enum": [
              "OBSERVED",
              "SOURCE_ATTRIBUTION",
              "HYPOTHESIS",
              "MISSING",
              "CONTRADICTED"
            ]
          },
          "source_ids": {
            "type": "array",
