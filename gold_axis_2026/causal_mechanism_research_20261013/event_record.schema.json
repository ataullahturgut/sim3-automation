{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gold mechanism event dossier (research only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "sampling_rule",
    "event_family",
    "timing",
    "preconditions",
    "trigger",
    "transmission",
    "response",
    "counterevidence",
    "comparators",
    "identification_grade",
    "provenance"
  ],
