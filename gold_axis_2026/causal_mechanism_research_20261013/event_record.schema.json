      "type": "string",
      "minLength": 1
    },
    "sampling_rule": {
      "type": "string",
      "minLength": 1
    },
    "event_family": {
      "type": "string",
      "minLength": 1
    },
    "timing": {
      "type": "object",
      "required": [
        "first_published_at_utc",
        "timestamp_confidence",
        "information_cutoff_utc"
      ],
      "properties": {
        "event_occurs_at_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "first_published_at_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "firstprint_earliest_utc": {
          "type": [
            "string",
            "null"
          ]
