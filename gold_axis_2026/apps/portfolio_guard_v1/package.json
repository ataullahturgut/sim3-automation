{
  "name": "portfolio-guard-replay-v1",
  "version": "1.0.0",
  "private": true,
  "description": "FROZEN Jan 2026 gold portfolio protection replay. Historical research only.",
  "scripts": {
    "start": "node server.js",
    "verify": "node server.js --verify",
    "test": "node --test test.js v2.test.js monthly_learning_v2.test.js monthly_runner.test.js",
    "audit": "node -e \"const a=require('./event_audit_v2').runAudit(); console.log(JSON.stringify({archive:a.archive,controls:a.timeSampledControls,temporal:a.chronologicalTest,events:a.critical.map(z=>({utc:z.utc,risk:z.analog,control:z.control,phase:z.phase}))},null,2))\"",
    "verify-months": "node -e \"const f=require('./monthly_runner').runFebruary(); console.log(JSON.stringify({month:f.month,start:f.scenarios.event15m.startUSD,models:Object.values(f.scenarios).map(x=>({mode:x.model,finalUSD:x.finalUSD,actions:x.actions.map(a=>({time:a.utc,act:a.action,price:a.price})),terminalAsset:x.terminalAsset}))},null,2))\""
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
